{
  "name": "greggs-menu-tests",
  "version": "1.0.0",
  "description": "Automated quality suite for the Greggs.com Menu (Playwright + TypeScript)",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:functional": "playwright test --project=functional",
    "test:a11y": "playwright test --project=a11y",
    "test:responsive": "playwright test --project=responsive",
    "test:mobile": "playwright test --project=mobile-android --project=mobile-ios",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "report": "playwright show-report reports/html",
    "report:perf": "playwright show-report reports/perf/html",
    "summary": "node scripts/summarise-results.mjs",
    "summary:perf": "node scripts/summarise-results.mjs reports/perf/results.json",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps chromium webkit"
  },
  "author": "Sukanya Avilineni",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
